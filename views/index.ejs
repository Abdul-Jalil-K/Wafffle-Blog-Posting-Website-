<%- include('partials/header.ejs') %>

<section class="body">
      <!-- This is my blog grid I made, again, completely native with no Bootstrap, or other libraries. it was difficult getting the alignment correct, and especially getting them to "start" on the same height. -->
        <!-- Main Blog List -->

        <div class="blog-grid">
          <div class="main-list">
            <ul class="blogs">
              <% if (blogs.length === 0) { %>
              <p>
                Nothing to talk about...
              </p>
              <% } else { %>
              <% blogs.forEach((blog) => { %>
              <li class="blog">
                <div class="date-container">
                  <p class="date Gregorian-date">
                    <%= blog.date %>
                  </p>
                  <p class="date Hijri-date hidden">
                    <%= blog.fullHijriDate %>
                  </p>
                </div>
                <h2 class="blog-title">
                  <a class="view-link" href="view/<%= blogs.indexOf(blog) %>">
                    <%= blog.title %>
                  </a>
                </h2>
                <p>
                  <%= blog.content %>
                </p>
                <hr />
              </li>
              <% }); %>
              <% } %>
            </ul>
          </div>

          <!-- Side Blog List -->
          <div class="side-list">
            <h2 class="sub-title">Recent Posts</h2>
            <ul class="side-blogs">
              <% if (blogs.length === 0) { %>
              <p>
                No blogs...
              </p>
              <% } else { %>
              <% blogs.forEach((blog) => { %>
              <li class="side-blog">
                <h2 class="blog-title">
                  <a class="view-link" href="view/<%= blogs.indexOf(blog) %>">
                    <%= blog.title %>
                  </a>
                </h2>
              </li>
              <% }); %>
              <% } %>
            </ul>
          </div>
        </div>
        
    </section>

<%- include('partials/footer.ejs') %>