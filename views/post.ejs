<%- include('partials/header.ejs') %>

<% if (locals.blogId) { %>
        <section class="body">
          <!-- Making this form post was easy, as I've many like this. Still, it was a nice part of the project that provided a nice breather from, well, everything else. -->

          <!-- Create New Post Form -->
          <div class="form">
            <form action="/edit" method="POST">
              <input id="title" class="blog-input" name="title" placeholder="Title" value="<%= title %>" />
              <textarea class="blog-input" name="body" placeholder="Body" value="">
                <%= content %>
              </textarea>
              <button type="submit" class="submit-btn">Post</button>
            </form>
          </div>
        </section>
<% } else { %>

      <section class="body">
        <!-- Making this form post was easy, as I've many like this. Still, it was a nice part of the project that provided a nice breather from, well, everything else. -->

        <!-- Create New Post Form -->
        <div class="form">
          <form action="/post" method="POST">
            <input id="title" class="blog-input" name="title" placeholder="Title" value="" />
            <textarea class="blog-input" name="body" placeholder="Body" value=""></textarea>
            <button type="submit" class="submit-btn">Post</button>
          </form>
        </div>
      </section>
<% } %>

<%- include('partials/footer.ejs') %>