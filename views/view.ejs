<%- include('partials/header.ejs') %>

<section class="body">
  <div class="view">
        <div class="date-container">
          <h2 class="date Gregorian-date">
            <%= postDate %>
          </h2>
          <h2 class="date Hijri-date hidden">
            <%= hijriPostDate %>
          </h2>
        </div>
    <h1 class="title">
        <%= title %>
    </h1>

    <div class="blog-body">
      <%= content %>
    </div>
  </div>
  <div class="buttons">
    <form action="/delete" method="POST">
        <input type="text" name="index" value="<%= blogId %>" hidden>
      <input type="text" name="The Beauty of Lorem Ipsum" value="The Beauty of Lorem Ipsum" hidden />
      <button type="submit" class="delete-btn">Delete Post</button>
    </form>
    <a class="edit-btn" href="/edit/<%= blogId %>"> Edit Post </a>
  </div>
</section>

<%- include('partials/footer.ejs') %>